@prefix :      <https://demo.local/ecat#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# 干净数据：全部合规
:sku_ok a :SKU ;
    :name "闪电跑鞋" ;
    :belongsToCategory :cat_running_shoes ;
